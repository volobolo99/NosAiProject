{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nosai.local/schemas/mcp_health_snapshot.schema.json",
  "title": "NosAi MCP health snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observations", "state_revision"],
  "properties": {
    "schema_version": {"const": "mcp.health.v1"},
    "state_revision": {"type": "integer", "minimum": 0},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "details", "observed_at", "expires_at"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["configured", "reachable", "authenticated", "qualified", "operational", "UNKNOWN"]},
          "details": {"type": "object"},
          "observed_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  }
}
