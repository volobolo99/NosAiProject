# Python
__pycache__/
# Anchored: setuptools writes these at the repository root only, while an
# unanchored pattern would also swallow any future build/ or dist/ source
# directory nested under a package.
/build/
/dist/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local runtime artifacts
/models/
*.gguf
*.db
*.sqlite
*.sqlite3
/logs/
# Anchored to the repository root: an unanchored pattern also matches the
# nosai/telemetry source package and silently hides it from git and tooling.
/telemetry/

# IDE / OS
.vscode/
.idea/
# Only the editor-local MCP config. NOT .cursor/ wholesale: .cursor/rules/*.mdc
# are tracked project rules and the M005 deliverable (SOURCE_OF_TRUTH.md rank 10).
.cursor/mcp.json
.DS_Store
Thumbs.db

# .NET build artifacts.
# Deliberately NOT anchored: every .csproj directory gets its own bin/ and obj/
# (e.g. src/NosAi.Runtime/bin), so these must match at any depth.
bin/
obj/
*.user

# Enrollment key material. A committed public key is a trust anchor nobody
# enrolled deliberately: a runtime started from a fresh clone would accept the
# device it belongs to. Keys live on the dedicated volume, per
# docs/INTEGRAZIONE_RSA_SESSION_AUTH.md.
*.pem
# Operator-local runtime data. The example keybind file is the schema, not a bind.
data/*
!data/keybinds.example.json

# Le calibrazioni dello schermo e i campioni da cui nascono restano invece
# versionati. Sono la misura del client reale -- sei numeri e le coppie
# pixel/casella che li producono -- e senza di loro il repository non sa
# riprodurre nessuna delle affermazioni che ci costruisce sopra. Il 2026-09-07
# sono quasi andati persi: erano scritti in C:\WINDOWS\system32\data\ perche'
# il comando era partito da li', e non esistevano da nessun'altra parte.
# La forma e' `data/perception/*` e non `data/perception/`: git non puo'
# re-includere nulla sotto una directory esclusa, quindi la directory va
# ri-ammessa prima del suo contenuto.
!data/perception/
data/perception/*
!data/perception/*.calibration
!data/perception/screen-samples*.txt

# WinDivert: resta fuori solo cio' che si scarica -- lo zip upstream e la cartella
# WinDivert-2.2.2-A che ne esce. Il probe e lo script di installazione no: sono
# codice di questo repository (il probe referenzia NosAi.Runtime.csproj, lo script
# e' scritto qui e cita ADR-0014), e sono i due strumenti che
# docs/TEST_RIMANDATI.md T-04 dice all'operatore di usare. La regola larga di prima
# li escludeva insieme al driver, quindi fino al 2026-09-07 sono esistiti su un
# disco solo e sono quasi andati via con la copia duplicata che li conteneva.
# La forma e' `tools/windivert/*` e non `tools/windivert/`: git non puo'
# re-includere nulla sotto una directory esclusa.
tools/windivert/*
!tools/windivert/probe/
!tools/windivert/install-and-capture.ps1
tools/windivert/probe/bin/
tools/windivert/probe/obj/

# Worktree e stato degli agenti (contiene copie complete del repository)
.claude/

# WinDivert: i binari sono versionati di proposito, con LICENSE e VERSION accanto,
# perche' ogni macchina compili senza scaricarli a mano. third_party/windivert/README.md

# I log dei test (dotnet test -l trx) non sono sorgente. Senza questa riga
# restano come file non tracciati in un albero gia condiviso fra piu sessioni.
TestResults/

# Dipendenze del server MCP locale (tools/deepseek-mcp). Non anchorate: ogni
# package.json ha la sua node_modules, e nessuna di queste e' sorgente.
node_modules/
