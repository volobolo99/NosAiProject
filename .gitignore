# Python
__pycache__/
# Anchored: setuptools writes these at the repository root only, while an
# unanchored pattern would also swallow any future build/ or dist/ source
# directory nested under a package.
/build/
/dist/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local runtime artifacts
/models/
*.gguf
*.db
*.sqlite
*.sqlite3
/logs/
# Anchored to the repository root: an unanchored pattern also matches the
# nosai/telemetry source package and silently hides it from git and tooling.
/telemetry/

# IDE / OS
.vscode/
.idea/
.cursor/
.DS_Store
Thumbs.db

# .NET build artifacts.
# Deliberately NOT anchored: every .csproj directory gets its own bin/ and obj/
# (e.g. src/NosAi.Runtime/bin), so these must match at any depth.
bin/
obj/
*.user
