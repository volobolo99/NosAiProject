<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roslyn analyzers ship as netstandard2.0: the compiler host that loads this
    assembly (VBCSCompiler under `dotnet build`, or devenv.exe in Visual
    Studio) is not necessarily the same runtime as the projects being
    analyzed, and netstandard2.0 is the one target both hosts can always
    load. Overrides the net8.0 default from the root Directory.Build.props.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>NosAi.Analyzers</RootNamespace>
    <AssemblyName>NosAi.Analyzers</AssemblyName>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
