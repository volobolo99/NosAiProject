<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NosAi.ControlPanel</RootNamespace>
    <AssemblyName>NosAi.ControlPanel</AssemblyName>
    <ApplicationTitle>NosAi Control Panel</ApplicationTitle>
    <Product>NosAi Control Panel</Product>
    <Description>Operator console for NosAiProject. Observes the runtime; it does not replace safety enforcement.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The panel hosts Gate1BootstrapHost in-process. The runtime remains the
         authority: this project is a WinExe shell, not a second orchestrator. -->
    <ProjectReference Include="..\NosAi.Runtime\NosAi.Runtime.csproj" />
  </ItemGroup>
</Project>
