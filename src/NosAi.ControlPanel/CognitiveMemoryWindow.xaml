<Window x:Class="NosAi.ControlPanel.CognitiveMemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NosAi — Cervello & Memoria"
        Width="1500" Height="900" MinWidth="1100" MinHeight="700"
        Background="#0B1120" Foreground="#E8EEF9"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#111A2D"/>
        <SolidColorBrush x:Key="Panel2" Color="#16223A"/>
        <SolidColorBrush x:Key="Line" Color="#263451"/>
        <SolidColorBrush x:Key="Muted" Color="#8EA0BD"/>
        <SolidColorBrush x:Key="Accent" Color="#63A4FF"/>
        <SolidColorBrush x:Key="Good" Color="#55D69B"/>
        <SolidColorBrush x:Key="Warn" Color="#F2C46D"/>
        <DataTemplate x:Key="TraceTemplate">
            <Border Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Node}" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Margin="12,0">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="MemoryTemplate">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icon}" FontSize="16"/>
                    <StackPanel Grid.Column="1" Margin="8,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold">NOSAI COGNITIVE OBSERVABILITY</TextBlock>
                <TextBlock FontSize="26" FontWeight="SemiBold" Margin="0,3,0,0">Cervello AI &amp; Memoria</TextBlock>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="11">Visualizzazione tecnica read-only · nessuna autorità di esecuzione</TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Aggiorna" Click="OnRefresh" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="Chiudi" Click="OnClose" Padding="14,8"/>
            </StackPanel>
        </DockPanel>
        <TabControl Grid.Row="1" Background="{StaticResource Panel}">
            <TabItem Header="🧠 CERVELLO AI">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Cognitive Flow" Margin="0,0,0,9"/>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="Ogni nodo viene colorato solo quando esiste un evento reale. UNKNOWN non viene trasformato in successo." Margin="0,0,0,10"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="TraceList" ItemTemplate="{StaticResource TraceTemplate}"/></ScrollViewer>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{StaticResource Muted}">ULTIMA DECISIONE</TextBlock>
                                <TextBlock x:Name="DecisionText" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" Text="UNKNOWN" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DecisionMeta" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Candidate" Margin="0,0,0,9"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="CandidateList"/></ScrollViewer>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="🗄 MEMORIA">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" FontSize="15" Text="Memory Explorer" Margin="4,4,4,12"/>
                            <ItemsControl x:Name="MemoryTree"/>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="4,15,4,0">Le categorie sono logiche. I dati vengono mostrati solo se presenti sul disco/runtime. Nessun dato simulato.</TextBlock>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Elementi" Margin="0,0,0,9"/>
                        <TextBox x:Name="MemorySearch" Margin="0,0,0,9" Padding="8" TextChanged="OnSearchChanged" ToolTip="Filtra memoria"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="MemoryList" ItemTemplate="{StaticResource MemoryTemplate}"/></ScrollViewer>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="15" Text="Inspector" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox x:Name="InspectorText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Muted}" FontFamily="Consolas"/></ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
