<Window x:Class="NosAi.ControlPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NosAi Control Panel"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
  <Window.Resources>
    <DataTemplate x:Key="SetupItemTemplate">
      <Border Style="{StaticResource CardChrome}" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0"/>
          <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FieldTemplate">
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Border Grid.Column="2" CornerRadius="6" Padding="8,3" Background="#1A2338">
            <TextBlock Text="{Binding Source}" FontSize="11" FontWeight="SemiBold"/>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusBarText" Text="Avvio…" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        <TextBlock x:Name="ClockText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Left" Width="232" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,22,20,12">
          <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold">NOSAI</TextBlock>
          <TextBlock FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0">Control Panel</TextBlock>
          <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap">Osserva il runtime. Non sostituisce Safety.</TextBlock>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
          <Border Background="#1A2338" CornerRadius="10" Padding="12">
            <StackPanel>
              <TextBlock x:Name="SidebarState" FontWeight="SemiBold" Text="OFFLINE"/>
              <TextBlock x:Name="SidebarDetail" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Runtime non avviato"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Margin="4,8,4,8">
          <Button x:Name="NavOverview" Style="{StaticResource NavButtonActive}" Content="Panoramica" Click="OnNav"/>
          <Button x:Name="NavClient" Style="{StaticResource NavButton}" Content="Client NosTale" Click="OnNav"/>
          <Button x:Name="NavMap" Style="{StaticResource NavButton}" Content="Mappa" Click="OnNav"/>
          <Button x:Name="NavPhone" Style="{StaticResource NavButton}" Content="Telefono Guard AI" Click="OnNav"/>
          <Button x:Name="NavPerception" Style="{StaticResource NavButton}" Content="Percezione" Click="OnNav"/>
          <Button x:Name="NavNetwork" Style="{StaticResource NavButton}" Content="Rete" Click="OnNav"/>
          <Button x:Name="NavDecision" Style="{StaticResource NavButton}" Content="Decisione" Click="OnNav"/>
          <Button x:Name="NavSecurity" Style="{StaticResource NavButton}" Content="Sicurezza" Click="OnNav"/>
          <Button x:Name="NavSuites" Style="{StaticResource NavButton}" Content="Certificazione" Click="OnNav"/>
          <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Impostazioni" Click="OnNav"/>
          <Button x:Name="NavLog" Style="{StaticResource NavButton}" Content="Diario" Click="OnNav"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="24,20,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,16">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource GhostButton}" Content="Apri cartella exe" Click="OnOpenExeFolder" Margin="0,0,8,0"/>
          <Button Style="{StaticResource LiveButton}" Content="Avvia runtime" Click="OnStartRuntime" Margin="0,0,8,0"/>
          <Button Style="{StaticResource GhostButton}" Content="Ricollega" Click="OnReconnect" Margin="0,0,8,0"/>
          <Button x:Name="StopButton" Style="{StaticResource GhostButton}" Content="Ferma" Click="OnStopRuntime" Margin="0,0,8,0"/>
          <Button Style="{StaticResource GhostButton}" Content="HALT" Click="OnHalt" Margin="0,0,8,0"/>
          <Button Style="{StaticResource DangerButton}" Content="STOP" Click="OnEmergencyStop"/>
        </StackPanel>
        <StackPanel>
          <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">CONSOLE OPERATORE</TextBlock>
          <TextBlock x:Name="PageTitle" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,0">Panoramica</TextBlock>
        </StackPanel>
      </DockPanel>

      <Grid Grid.Row="1">
        <!-- Overview -->
        <ScrollViewer x:Name="ViewOverview" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource CardChrome}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource CardLabel}" Text="MODALITÀ"/>
                <TextBlock x:Name="OverviewMode" FontSize="18" FontWeight="SemiBold" Text="OFFLINE"/>
                <TextBlock x:Name="OverviewModeHint" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Nessun runtime. Premere Avvia, oppure lasciare l'auto-avvio attivo."/>
              </StackPanel>
            </Border>
            <UniformGrid Columns="2" Margin="0,0,0,14">
              <Border Style="{StaticResource CardChrome}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardLabel}" Text="CANALE (QUESTO BUILD)"/>
                  <TextBlock x:Name="OverviewWire" FontSize="18" FontWeight="SemiBold" Text="v3"/>
                  <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                             Text="Wire v3. Un APK v2 viene rifiutato all'header. Non è una lettura dal filo."/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardChrome}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardLabel}" Text="SLOT GUARD"/>
                  <TextBlock x:Name="OverviewSlot" FontSize="18" FontWeight="SemiBold" Text="UNKNOWN"/>
                  <TextBlock x:Name="OverviewSlotHint" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <TextBlock x:Name="OverviewPhoneReminder" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBlock x:Name="OverviewRecovery" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>
            <UniformGrid Columns="4" Margin="0,0,0,14">
              <Border Style="{StaticResource CardChrome}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardLabel}" Text="RUNTIME"/>
                  <TextBlock x:Name="OverviewHealth" FontSize="20" FontWeight="SemiBold" Text="Offline"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardChrome}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardLabel}" Text="CLIENT"/>
                  <TextBlock x:Name="OverviewClient" FontSize="20" FontWeight="SemiBold" Text="UNKNOWN"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardChrome}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardLabel}" Text="GUARD AI"/>
                  <TextBlock x:Name="OverviewGuard" FontSize="20" FontWeight="SemiBold" Text="UNKNOWN"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardChrome}">
                <StackPanel>
                  <TextBlock Style="{StaticResource CardLabel}" Text="ESECUZIONE"/>
                  <TextBlock x:Name="OverviewSafety" FontSize="20" FontWeight="SemiBold" Text="UNKNOWN"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <TextBlock x:Name="OverviewAuthority" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14" Text="Sessione: UNKNOWN"/>
            <TextBlock FontWeight="SemiBold" Margin="0,4,0,10">Auto-configurazione</TextBlock>
            <ItemsControl x:Name="SetupList" ItemTemplate="{StaticResource SetupItemTemplate}"/>
            <TextBlock FontWeight="SemiBold" Margin="0,16,0,10">Resilienza</TextBlock>
            <ItemsControl x:Name="ResilienceFields" ItemTemplate="{StaticResource FieldTemplate}"/>
            <TextBlock x:Name="OverviewWarning" Foreground="{StaticResource WarnBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewClient" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap">Baseline OS: processo e finestra. Il gameplay resta UNKNOWN finché non esiste un provider di memoria.</TextBlock>
            <ItemsControl x:Name="ClientFields" ItemTemplate="{StaticResource FieldTemplate}"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewMap" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap">
              Griglia statica e cella di appoggio. UNKNOWN è un disegno proprio, non una cella vuota e non il fuori-griglia. L'occupancy dinamica non è sullo snapshot: non è disegnata, quindi una cella chiara è solo geometria, non «libero».
            </TextBlock>
            <ItemsControl x:Name="MapFields" ItemTemplate="{StaticResource FieldTemplate}"/>
            <Border Style="{StaticResource CardChrome}" Margin="0,16,0,14">
              <StackPanel>
                <TextBlock Style="{StaticResource CardLabel}" Text="CELLA DI APPOGGIO"/>
                <TextBlock x:Name="StandingCellText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="Cella di appoggio: UNKNOWN"/>
              </StackPanel>
            </Border>
            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6">Ritaglio 31×31</TextBlock>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" FontFamily="Consolas" Text="· calpestabile    # bloccata    × fuori griglia    ? UNKNOWN"/>
            <Border Style="{StaticResource CardChrome}" HorizontalAlignment="Left">
              <TextBlock x:Name="MapCropGlyphs" FontFamily="Consolas" FontSize="11" Text="?"/>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewPhone" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap">Abbinamento via USB. Nessun indirizzo da digitare: il telefono trova il PC in discovery. Questo build parla wire v3: un APK v2 viene rifiutato all'header. Senza Python l'abbinamento non è riuscito.</TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Style="{StaticResource PrimaryButton}" Content="Abbina telefono" Click="OnPairPhone" Margin="0,0,8,0"/>
              <Button Style="{StaticResource GhostButton}" Content="Solo raccogli chiave" Click="OnEnrollPhone"/>
            </StackPanel>
            <TextBlock x:Name="PairingStatus" Foreground="{StaticResource WarnBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>
            <ItemsControl x:Name="GuardFields" ItemTemplate="{StaticResource FieldTemplate}"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewPerception" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap">ADR-0012: barra HP/MP da schermo, DERIVED solo se la firma della barra combacia, altrimenti UNKNOWN. I numeri restano UNKNOWN finché i glifi non sono addestrati. L'addestramento prende HP LIVE dal canale world, non dalla schermata: senza osservazione di rete il rifiuto è label_not_live. Il probe non entra nello snapshot Gate 1. I ritagli finiscono in data/perception/crops (gitignored) per controllare la ROI.</TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
              <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Content="Esegui probe DXGI" Click="OnDxgiProbe" Margin="0,0,8,0"/>
              <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Content="Addestra glifi HUD dal wire" Click="OnTrainGlyphs"/>
            </StackPanel>
            <TextBlock x:Name="PerceptionSummary" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,8" TextWrapping="Wrap"
                       Text="Nessun probe in questa sessione. Il risultato non entra nello snapshot Gate 1."/>
            <ItemsControl x:Name="PerceptionFields" ItemTemplate="{StaticResource FieldTemplate}" Margin="0,0,0,16"/>
            <TextBlock Margin="0,8,0,8" FontWeight="SemiBold">Hardware osservato</TextBlock>
            <ItemsControl x:Name="HardwareFields" ItemTemplate="{StaticResource FieldTemplate}"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewNetwork" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap">Porte di questa console e ascolto su 127.0.0.1. Non è uno scan LAN e non è politica di sicurezza.</TextBlock>
            <ItemsControl x:Name="NetworkFields" ItemTemplate="{StaticResource FieldTemplate}"/>
            <TextBlock Margin="0,16,0,8" FontWeight="SemiBold">Osservazione gioco</TextBlock>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap">Canale world del client: attivo solo con endpoint impostato e driver aperto. UNKNOWN col motivo, mai 0 al posto di un dato non letto.</TextBlock>
            <ItemsControl x:Name="GameObservationFields" ItemTemplate="{StaticResource FieldTemplate}"/>
            <TextBlock Margin="0,16,0,8" FontWeight="SemiBold">Salute API</TextBlock>
            <ItemsControl x:Name="HealthFields" ItemTemplate="{StaticResource FieldTemplate}"/>
            <TextBlock Margin="0,16,0,8" FontWeight="SemiBold">Registro eventi</TextBlock>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap">Salute dell'audit trail. Un registro con buchi si vede come incompleto.</TextBlock>
            <ItemsControl x:Name="EventLogFields" ItemTemplate="{StaticResource FieldTemplate}"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewDecision" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap">Ciclo Gate 3 sullo snapshot canonico. ActingEnabled=false è la politica sicura (ADR-0016): decide, non agisce. In modalità COLLEGATO il ciclo vive in un altro processo e questa vista è UNKNOWN, non zero. Gli esiti si elencano per tipo: NoWorldState, NoCandidate e RefusedStaleInput non sono lo stesso fallimento.</TextBlock>
            <ItemsControl x:Name="DecisionFields" ItemTemplate="{StaticResource FieldTemplate}"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewSecurity" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap">Osserva i file di identità. Il wrap DPAPI lo fa il runtime (ADR-0010). UNKNOWN se un file manca.</TextBlock>
            <ItemsControl x:Name="SecurityFields" ItemTemplate="{StaticResource FieldTemplate}"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewSuites" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap">Ogni pulsante lancia la suite corrispondente. Un fallimento è un fallimento: le suite non vengono indebolite da qui.</TextBlock>
            <WrapPanel x:Name="SuiteButtons"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap">Le modifiche si applicano al prossimo avvio del runtime. Non sono politica di sicurezza.</TextBlock>
            <Label Content="Porta API operatore" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="SettingDashboardPort"/>
            <Label Content="Porta Guard" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="SettingGuardPort"/>
            <Label Content="Timeout operazione (ms)" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="SettingTimeout"/>
            <Label Content="Nomi processo client" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="SettingClientProcess"/>
            <CheckBox x:Name="SettingDiscovery" Content="Discovery LAN (il telefono trova il PC da solo)"/>
            <CheckBox x:Name="SettingLoopback" Content="Solo loopback (disabilita Wi-Fi)"/>
            <CheckBox x:Name="SettingAutoStart" Content="Avvia il runtime all'apertura di questa console"/>
            <Label Content="Endpoint osservazione gioco (host:porta, vuoto = spento)" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Rileva endpoint" Click="OnDetectObserveGame" Margin="8,0,0,0"/>
              <TextBox x:Name="SettingObserveGame"/>
            </DockPanel>
            <CheckBox x:Name="SettingRunDecisionLoop" Content="Avvia il ciclo di decisione Gate 3 (decide, non agisce)" Margin="0,12,0,0"/>
            <Label Content="Intervallo decisione (ms)" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="SettingDecisionIntervalMs"/>
            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Content="Salva impostazioni" Click="OnSaveSettings"/>
          </StackPanel>
        </ScrollViewer>

        <DockPanel x:Name="ViewLog" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource GhostButton}" Content="Svuota diario" Click="OnClearLog" Margin="0,0,8,0"/>
            <Button Style="{StaticResource GhostButton}" Content="Apri diario su disco" Click="OnOpenOperatorLog"/>
          </StackPanel>
          <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
              <RichTextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" IsDocumentEnabled="True"/>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
