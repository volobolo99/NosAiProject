<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NosAi.Runtime</RootNamespace>
    <AssemblyName>NosAi.Runtime</AssemblyName>
    <UseWPF>false</UseWPF>
    <!-- Several imported Gate/Host sources still declare their own Main.
         The runtime entry point is explicit so the build is deterministic. -->
    <StartupObject>NosAi.Runtime.Program</StartupObject>
    <!-- Without this, GetClientRect returns virtualised coordinates on any
         display whose scale is not 100%. Per-monitor v2 is what makes those
         readings physical pixels, which is what the rest of perception assumes. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The DXGI Desktop Duplication backend calls COM vtable slots through
         unmanaged function pointers (src/NosAi.Runtime/Perception/DxgiInterop.cs);
         no external interop package is pulled in for it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Gate 2 mandates the real WAL SQLite store defined by the centralized policy
         (docs/PERSISTENZA_SQLITE_E_SHARED_MEMORY.md); this replaces the earlier
         placeholder file-append logger in Gate2Runtime.cs. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- X25519 for the ephemeral-session crypto (docs/CRITTOGRAFIA_NOISE_E_CHIAVI_EFFIMERE.md):
         the .NET BCL has no Curve25519, so the vetted BouncyCastle primitive backs
         the C# counterpart of nosai/security/ephemeral_session.py. AEAD (ChaCha20-
         Poly1305) and HKDF come from the BCL. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <!-- DPAPI for the runtime identity (docs/adr/ADR-0010-key-custody.md). .NET 8
         moved ProtectedData out of the BCL into this first-party package, and it is
         the only way to reach DPAPI from managed code; the runtime is already
         Windows-only, so nothing portable is given up. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The canonical PC/phone wire format, shared with the Guard AI client so the
         two ends cannot drift. See docs/adr/ADR-0006-canonical-phone-channel.md. -->
    <ProjectReference Include="..\NosAi.Protocol\NosAi.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project reaches a few internals on purpose. ScopedLiveCaptureBackend
         keeps its raw-source constructor internal so no production caller can wrap a
         replayed source in a class that labels its packets LIVE; the tests still have
         to exercise it, and this is how without widening that door. -->
    <InternalsVisibleTo Include="NosAi.Runtime.Tests" />
  </ItemGroup>
</Project>
