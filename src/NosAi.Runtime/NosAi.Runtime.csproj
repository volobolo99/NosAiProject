<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NosAi.Runtime</RootNamespace>
    <AssemblyName>NosAi.Runtime</AssemblyName>
    <UseWPF>false</UseWPF>
    <!-- Several imported Gate/Host sources still declare their own Main.
         The runtime entry point is explicit so the build is deterministic. -->
    <StartupObject>NosAi.Runtime.Program</StartupObject>
    <!-- Without this, GetClientRect returns virtualised coordinates on any
         display whose scale is not 100%. Per-monitor v2 is what makes those
         readings physical pixels, which is what the rest of perception assumes. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The DXGI Desktop Duplication backend calls COM vtable slots through
         unmanaged function pointers (src/NosAi.Runtime/Perception/DxgiInterop.cs);
         no external interop package is pulled in for it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NosAi.Protocol\NosAi.Protocol.csproj" />
    <!-- PracticalTestRun and the canonical T1-T20 catalog are Core contracts.
         Keep the dependency explicit so Runtime and the Control Panel consume
         the same test definitions instead of duplicating them. -->
    <ProjectReference Include="..\NosAi.Core\NosAi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../third_party/windivert/WinDivert.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)../../third_party/windivert/WinDivert.dll')"
          CopyToOutputDirectory="PreserveNewest"
          Link="WinDivert.dll" />
    <None Include="$(MSBuildThisFileDirectory)../../third_party/windivert/WinDivert64.sys"
          Condition="Exists('$(MSBuildThisFileDirectory)../../third_party/windivert/WinDivert64.sys')"
          CopyToOutputDirectory="PreserveNewest"
          Link="WinDivert64.sys" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NosAi.Runtime.Tests" />
  </ItemGroup>
</Project>
