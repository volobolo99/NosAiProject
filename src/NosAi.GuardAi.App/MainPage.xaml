<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:guard="clr-namespace:NosAi.GuardClient;assembly=NosAi.GuardClient"
             x:Class="NosAi.GuardAi.App.MainPage"
             Title="NosAi Guard AI">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Guard AI" FontSize="26" FontAttributes="Bold" />
            <Label Text="Sola osservazione. Lo stato di sicurezza qui sotto è quello dichiarato dal runtime, non da questa app."
                   FontSize="13" TextColor="Gray" />

            <Frame BorderColor="LightGray" Padding="14" CornerRadius="8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Collegamento" FontAttributes="Bold" />

                    <!-- The only decision the operator makes. Everything else -
                         address, key, pairing - is resolved by the app. -->
                    <HorizontalStackLayout Spacing="10">
                        <RadioButton x:Name="UsbOption" Content="USB" GroupName="transport"
                                     CheckedChanged="OnTransportChanged" />
                        <RadioButton x:Name="WiFiOption" Content="Wi-Fi" GroupName="transport"
                                     CheckedChanged="OnTransportChanged" />
                    </HorizontalStackLayout>
                    <Label x:Name="TransportHint" FontSize="12" TextColor="Gray" />

                    <HorizontalStackLayout Spacing="10">
                        <Button x:Name="ConnectButton" Text="Connetti" Clicked="OnConnectClicked" />
                        <Button x:Name="DisconnectButton" Text="Disconnetti" Clicked="OnDisconnectClicked"
                                IsEnabled="False" />
                    </HorizontalStackLayout>

                    <!-- Where this device's private key lives (ADR-0010). Reported
                         rather than assumed: a phone whose key store was unavailable
                         must not look protected. -->
                    <Label x:Name="CustodyLabel" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="LightGray" Padding="14" CornerRadius="8">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Stato" FontAttributes="Bold" />
                    <Label x:Name="StateLabel" Text="NON CONNESSO" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="DetailLabel" Text="Nessuna sessione avviata." FontSize="13" TextColor="Gray" />
                    <Label x:Name="ObservedLabel" Text="" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- Read from the snapshot, never asserted here. The runtime is the
                 safety authority (ADR-0003); this screen reports what it says. -->
            <Frame BorderColor="LightGray" Padding="14" CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Sicurezza (dal runtime)" FontAttributes="Bold" />
                    <Label x:Name="ExecutionLabel" Text="Sconosciuto finché non c'è una sessione."
                           FontSize="13" />
                    <CollectionView x:Name="SafetyView" HeightRequest="96">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="guard:ClassifiedField">
                                <Grid Padding="0,6" ColumnDefinitions="150,*">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="14" TextColor="Gray" />
                                    <Label Grid.Column="1" Text="{Binding Display}" FontSize="14" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="LightGray" Padding="14" CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Client NosTale" FontAttributes="Bold" />
                    <Label Text="UNKNOWN significa non osservato. Non è zero e non è assente."
                           FontSize="12" TextColor="Gray" />
                    <CollectionView x:Name="FieldsView" HeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="guard:ClassifiedField">
                                <Grid Padding="0,6" ColumnDefinitions="120,*">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontSize="14" TextColor="Gray" />
                                    <Label Grid.Column="1" Text="{Binding Display}" FontSize="14" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
