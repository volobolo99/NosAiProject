<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>NosAi.Security</RootNamespace>
    <AssemblyName>NosAi.Security</AssemblyName>
    <!-- docs/ROADMAP_ESECUTIVA.md S:2.4 asks for [SkipLocalsInit] on FrameCodec and
         reserves AllowUnsafeBlocks for NosAi.Adapter only; the C# compiler requires
         /unsafe to apply [SkipLocalsInit] at all, even though no pointer or unsafe
         code is written here. This is that one narrow exception, not a reopening of
         "unsafe" as a general license for this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NosAi.Core\NosAi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Noise Protocol Framework (Noise_XX_25519_ChaChaPoly_SHA256), spec revision 33.
         Hand-rolling a Noise handshake instead of using a maintained, spec-conformant
         implementation would be introducing hand-rolled cryptography for no benefit
         (ADR-0015 S:6). Pinned exact version, no floating range. -->
    <PackageReference Include="Noise.NET" Version="1.0.0" />
  </ItemGroup>
</Project>
