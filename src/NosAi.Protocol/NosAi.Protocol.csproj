<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The namespace stays NosAi.Runtime.Gate1: these types did not change meaning
         when they moved out of the runtime assembly, and keeping it means no call
         site had to be rewritten. -->
    <RootNamespace>NosAi.Runtime.Gate1</RootNamespace>
    <AssemblyName>NosAi.Protocol</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Plain net8.0 with no dependencies: the runtime is Windows-only and the Guard
         AI application is Android, so the one thing they must agree on has to build
         for both. -->
  </PropertyGroup>
</Project>
