<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- A run that discovers zero tests must fail, not report success. Without
         this, an assembly that cannot be loaded (SDK/runner mismatch, or a
         Windows Application Control policy blocking the DLL) makes `dotnet test`
         exit 0 having executed nothing, and both CI and scripts/test.ps1 report
         green on a suite that never ran. -->
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
</RunSettings>
