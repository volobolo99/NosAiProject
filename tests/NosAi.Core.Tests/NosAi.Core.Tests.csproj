<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>NosAi.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Drives NoMockOnCriticalPathAnalyzer directly against in-memory source in
         NoMockOnCriticalPathAnalyzerTests.cs; not an analyzer reference here. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NosAi.Core\NosAi.Core.csproj" />
    <ProjectReference Include="..\..\src\NosAi.Storage\NosAi.Storage.csproj" />
    <ProjectReference Include="..\..\src\NosAi.Security\NosAi.Security.csproj" />
    <ProjectReference Include="..\..\src\NosAi.Adapter\NosAi.Adapter.csproj" />
    <ProjectReference Include="..\..\src\NosAi.Host\NosAi.Host.csproj" />
    <ProjectReference Include="..\..\tools\NosAi.Analyzers\NosAi.Analyzers.csproj" />
  </ItemGroup>
</Project>
