<Project>
  <!--
    docs/ROADMAP_ESECUTIVA.md Gate 1 (see docs/adr/ADR-0015) asks for these settings
    at the repository root. They are scoped here to the new Gate-based projects only,
    not applied unconditionally to every project in the tree: the existing
    NosAi.Runtime / NosAi.Protocol / NosAi.GuardClient / NosAi.ControlPanel /
    NosAi.GuardAi.App projects predate this file, do not opt into Nullable or
    warnings-as-errors today, and ADR-0015 commits to keeping them building with
    their existing tests green exactly as they are. Turning these on for them here
    would silently break a working build to satisfy a spec that was never written
    with them in mind, which is the opposite of what this file is for.
  -->
  <PropertyGroup Condition="
      '$(MSBuildProjectName)' == 'NosAi.Core' OR
      '$(MSBuildProjectName)' == 'NosAi.Perception' OR
      '$(MSBuildProjectName)' == 'NosAi.Adapter' OR
      '$(MSBuildProjectName)' == 'NosAi.Security' OR
      '$(MSBuildProjectName)' == 'NosAi.Storage' OR
      '$(MSBuildProjectName)' == 'NosAi.Host' OR
      '$(MSBuildProjectName)' == 'NosAi.Core.Tests' OR
      '$(MSBuildProjectName)' == 'NosAi.Bench' OR
      '$(MSBuildProjectName)' == 'NosAi.Analyzers'">
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- Raw pointers are needed only for Win32 process/window I/O (docs/ROADMAP_ESECUTIVA.md S:2.4). -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'NosAi.Adapter'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    INV-04 (docs/ROADMAP_ESECUTIVA.md S:1.2): NOSAI0001 runs only inside the
    six critical-path assemblies from the dependency graph in S:1.3, not in
    tests or tooling. A test project legitimately never needs a mock either,
    but that is a different guarantee (this repo's own no-mock test policy)
    from "the shipped critical path cannot load one even by accident", which
    is what this rule enforces. NosAi.Analyzers cannot reference itself.

    SetTargetFramework/SkipGetTargetFrameworkProperties/UndefineProperties pin
    this reference to netstandard2.0 explicitly: without them the SDK's cross
    project target-framework negotiation re-evaluates the referencing project
    with a blank global TargetFramework to probe compatibility, and a blank
    global property cannot be overridden by this file's own conditional
    default, which turns every one of these builds into NETSDK1013.
  -->
  <ItemGroup Condition="
      '$(MSBuildProjectName)' == 'NosAi.Core' OR
      '$(MSBuildProjectName)' == 'NosAi.Perception' OR
      '$(MSBuildProjectName)' == 'NosAi.Adapter' OR
      '$(MSBuildProjectName)' == 'NosAi.Security' OR
      '$(MSBuildProjectName)' == 'NosAi.Storage' OR
      '$(MSBuildProjectName)' == 'NosAi.Host'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)tools\NosAi.Analyzers\NosAi.Analyzers.csproj"
                       OutputItemType="Analyzer"
                       ReferenceOutputAssembly="false"
                       SetTargetFramework="TargetFramework=netstandard2.0"
                       SkipGetTargetFrameworkProperties="true"
                       UndefineProperties="TargetFramework" />
  </ItemGroup>
</Project>
