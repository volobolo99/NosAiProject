        "LAB-01"
      ],
      "objective": "Transactional shared state and JSON migration",
      "files": [
        "nosai/mcp/state.py",
        "nosai/mcp/bindings.py",
        "nosai/mcp/router.py",
        "config/mcp.default.json",
        "schemas/mcp_role_binding.schema.json"
      ],
      "acceptance": [
        "two processes observe same revision",
        "stale write rejected",
        "rollback survives restart",
        "crash does not partially promote"
      ],
      "status": "IMPLEMENTED_UNVERIFIED",
      "implementation_notes": "SQLite WAL store, JSON migration backup, monotone revision, idempotency and leases are present; multi-process and restart evidence remains to be recorded."
    },
    {
      "id": "LAB-03",
      "depends_on": [
