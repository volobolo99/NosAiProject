      "acceptance": [
        "restart resumes checkpoint",
        "expired lease fenced",
        "offline mode makes no remote calls",
        "missing observation stays UNKNOWN"
      ],
      "status": "PLANNED"
    },
    {
      "id": "LAB-04",
      "depends_on": [
        "LAB-02"
      ],
