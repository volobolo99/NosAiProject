    {
      "id": "LAB-01",
      "depends_on": [],
      "objective": "Close caller-asserted audit promotion gap with authenticated evidence authority",
      "files": [
        "nosai/mcp/evidence.py",
        "nosai/mcp/bindings.py",
        "nosai/mcp/chief.py",
        "nosai/mcp/dashboard.py",
        "nosai/mcp/server.py",
        "schemas/mcp_evidence_record.schema.json"
