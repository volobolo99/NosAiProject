{
  "schemaVersion": 1,
  "modelId": "nosai-yolov8",
  "family": "yolov8-detection",
  "format": "onnx",
  "status": "contract-only",
  "modelFile": "nosai-yolov8.onnx",
  "input": {
    "name": "images",
    "width": 640,
    "height": 640,
    "layout": "NCHW",
    "channels": 3,
