  "inference": {
    "confidenceThreshold": 0.35,
    "maxDetections": 128
  },
  "classes": [
    "player",
    "mob",
    "npc",
    "drop",
    "portal",
    "interactable"
  ],
  "provenance": {
    "modelHashSha256": null,
    "trainedDataset": null,
    "validationReport": null,
    "note": "This manifest defines the runtime contract only. It does not claim that a validated NosTale model asset exists. Install a model and fill the provenance fields before marking the backend production-ready."
  }
}
